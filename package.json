{
  "name": "pd-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first, global platform to build, publish, and monetize AI-assisted apps on public-domain IP.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @pd/db generate",
    "db:seed": "pnpm --filter @pd/db seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "prisma", "@prisma/client"]
  }
}
